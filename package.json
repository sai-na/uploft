{
  "name": "upload-tracker-for-drive",
  "version": "1.0.0",
  "description": "Chrome extension for tracking Google Drive upload progress with real-time notifications",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/bundle.js && node scripts/build.js",
    "package": "npm run build && node scripts/package.js",
    "watch": "tsc --watch",
    "lint": "eslint src test --ext .ts,.tsx",
    "lint:fix": "eslint src test --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.eslint.json",
    "test": "node scripts/test.js",
    "prepare": "husky"
  },
  "keywords": [
    "chrome-extension",
    "google-drive",
    "upload-tracker",
    "notifications"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.0",
    "typescript": "^5.4.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  }
}
