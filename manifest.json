{
  "manifest_version": 3,
  "name": "Upload Tracker for Drive",
  "version": "1.0.0",
  "description": "Track Google Drive upload progress with real-time notifications and visual progress indicators",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://drive.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content/content.bundle.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
